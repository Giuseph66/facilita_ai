{
  "name": "@facilita/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node scripts/dev.mjs main",
    "dev:worker": "node scripts/dev.mjs worker",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src scripts tests",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:supervisor": "node --test scripts/dev-supervisor.test.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "model:install": "node scripts/install-embedding.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "argon2": "^0.44.0",
    "bullmq": "6.3.11",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "drizzle-orm": "0.45.3",
    "fast-xml-parser": "^5.3.2",
    "fflate": "^0.8.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "nodemailer": "^7.0.10",
    "pdfjs-dist": "^5.4.449",
    "pg": "^8.16.3",
    "playwright": "1.63.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.7",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "vitest": "^4.0.8"
  }
}
