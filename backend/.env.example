NODE_ENV=development
APP_ORIGIN=http://localhost:3000
API_PORT=3001
POSTGRES_USER=facilita_migrator
POSTGRES_PASSWORD=replace-with-generated-local-password
POSTGRES_DB=facilita_estudo
DATABASE_URL=postgresql://facilita_runtime:replace-with-generated-local-password@127.0.0.1:5432/facilita_estudo
DATABASE_MIGRATION_URL=postgresql://facilita_migrator:replace-with-generated-local-password@127.0.0.1:5432/facilita_estudo
RUNTIME_DB_PASSWORD=replace-with-generated-local-password
REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=facilita
STORAGE_PATH=.storage
VAULT_ACTIVE_KEY_ID=v1
VAULT_KEYS_JSON={"v1":"replace-with-32-byte-base64-key"}
AI_PROVIDER=ollama
OLLAMA_CLOUD_BASE_URL=https://ollama.com
PLATFORM_AI_PROVIDER=disabled
PLATFORM_AI_API_KEY=
PLATFORM_AI_MODEL=
EMBEDDING_PROVIDER=cpu
EMBEDDING_MODEL_ID=Xenova/multilingual-e5-small
EMBEDDING_MODEL_REVISION=
EMBEDDING_CACHE_PATH=.models
SESSION_IDLE_TTL_SECONDS=86400
SESSION_ABSOLUTE_TTL_SECONDS=2592000
UPLOAD_MAX_BYTES=26214400
UPLOAD_MAX_PAGES=500
PARSER_TIMEOUT_MS=60000
AI_REQUEST_TIMEOUT_MS=90000
AI_JOB_TIMEOUT_MS=600000
AI_MAX_ATTEMPTS=3
EXPORT_TTL_SECONDS=3600
LOG_LEVEL=info
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Facilita Estudo <nao-responda@facilita.local>
